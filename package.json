{
  "name": "openclaw-icloud-calendar",
  "version": "0.1.0",
  "description": "OpenClaw plugin: read and write Apple iCloud Calendar over CalDAV, with a cross-platform credential store, request timeouts/retries, and a confirm-gated delete.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaiMingshen/openclaw-icloud-calendar.git"
  },
  "homepage": "https://github.com/CaiMingshen/openclaw-icloud-calendar#readme",
  "bugs": {
    "url": "https://github.com/CaiMingshen/openclaw-icloud-calendar/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "openclaw-icloud-calendar": "./dist/cli.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": ">=2026.5.17"
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "caldav",
    "icloud",
    "apple-calendar",
    "calendar",
    "icalendar",
    "tool-plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node dist/cli.js",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "openclaw plugins validate --entry ./dist/index.js",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "typebox": "1.3.30"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "^2026.9.7",
    "typescript": "^5.6.0",
    "undici": "^6.29.0",
    "vitest": "^2.1.0"
  }
}
